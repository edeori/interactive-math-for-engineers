{
  "id": "estimate-time-constant",
  "version": 1,
  "title": "Időállandó becslése mérésből",
  "skillIds": ["time-constant"],
  "difficulty": 2,
  "context": "electronics",
  "parameters": {
    "initialVoltage": { "type": "integer", "min": 3, "max": 12 },
    "measurementTime": { "type": "decimal", "min": 0.2, "max": 2, "step": 0.1 },
    "measuredVoltage": {
      "type": "derived",
      "expression": "initialVoltage / e",
      "decimals": 3
    }
  },
  "promptTemplate": "Egy kondenzátor {{initialVoltage}} V-ról cseng le. t={{measurementTime}} s-nál {{measuredVoltage}} V-ot, vagyis körülbelül a kezdeti érték 36,8%-át mérjük. Becsüld meg τ értékét!",
  "answerType": "numeric",
  "solution": { "type": "formula", "expression": "measurementTime" },
  "hints": [
    {
      "id": "one-tau",
      "text": "Egy időállandó elteltével az érték A₀/e, körülbelül 36,8%."
    }
  ],
  "validators": [
    {
      "type": "numeric-tolerance",
      "absoluteTolerance": 0.001,
      "relativeTolerance": 0
    }
  ],
  "unit": "s"
}
